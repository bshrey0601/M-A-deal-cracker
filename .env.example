# GROQ_API_KEY: optional. Powers the AI-written investment thesis and the
# "Use AI estimate" fallback. Free key at https://console.groq.com/keys
# Live market data needs no key: financials come from SEC EDGAR (US companies) or
# Yahoo Finance, prices from Finnhub, Yahoo Finance, CNBC or Stooq.
GROQ_API_KEY=

# PORT: optional, defaults to 3000. Hosts like Render set this automatically.
# PORT=3000

# SEC_USER_AGENT: recommended. The SEC asks automated clients to identify themselves
# with a name and contact email, e.g. "Jane Doe jane@example.com".
# SEC_USER_AGENT=

# FINNHUB_API_KEY: recommended on cloud hosts (Render etc.), where Yahoo often blocks
# requests. Used first for US share prices. Free key at https://finnhub.io/register
# FINNHUB_API_KEY=
